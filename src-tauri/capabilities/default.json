{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "ffmpeg-aarch64-apple-darwin", "sidecar": true, "args": true },
        { "name": "ffprobe-aarch64-apple-darwin", "sidecar": true, "args": true }
      ]
    },
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [
        { "name": "ffmpeg-aarch64-apple-darwin", "sidecar": true, "args": true }
      ]
    }
  ]
}
