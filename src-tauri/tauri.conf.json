{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "视频压缩工具",
  "version": "1.0.0",
  "identifier": "com.lele.video-compressor-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "视频压缩工具 — 便携视频处理箱",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "便携视频处理箱（内置 ffmpeg）",
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "NOTICE-ffmpeg-GPL.md",
      "LICENSE-GPLv2.txt"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
